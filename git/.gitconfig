[user]
	name = Jianzu Guan
	email = git@jzg.fastmail.com 

[core]
	excludesFile = ~/.config/git/ignore

[init]
  defaultBranch = main

[pull]
  rebase = true

[push]
	default = simple
	autoSetupRemote = true

[alias]
	a = add
	b = branch --sort=-committerdate
	c = checkout
	s = status
	l = log --oneline -n 10
